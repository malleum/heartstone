class_name HumanRig
extends RefCounted
## The hybrid human: a sourced skeleton and authored animation clips (Quaternius,
## CC0, see docs/ASSETS.md) wearing a body and clothes generated by Creature.
## The generator is simply told where this rig's joints are and skins to its bones,
## so every clip in the library drives the generated character with no retargeting.

const SCENE := "res://assets/quaternius/animation_library.glb"
const C := preload("res://src/gen/creature.gd")
# Generator joint order (Creature.BONES) -> bone names in the sourced rig.
const MAP: Array[String] = ["DEF-hips", "DEF-spine.001", "DEF-spine.003", "DEF-neck", "DEF-head",
	"DEF-shoulder.L", "DEF-upper_arm.L", "DEF-forearm.L", "DEF-hand.L", "DEF-thigh.L", "DEF-shin.L", "DEF-foot.L", "DEF-toe.L",
	"DEF-shoulder.R", "DEF-upper_arm.R", "DEF-forearm.R", "DEF-hand.R", "DEF-thigh.R", "DEF-shin.R", "DEF-foot.R", "DEF-toe.R"]

static func _skeleton(n: Node) -> Skeleton3D:
	if n is Skeleton3D:
		return n
	for c in n.get_children():
		var s := _skeleton(c)
		if s: return s
	return null

static func _player(n: Node) -> AnimationPlayer:
	if n is AnimationPlayer:
		return n
	for c in n.get_children():
		var a := _player(c)
		if a: return a
	return null

## Reads the rig's rest pose into the spec. Main thread only (it loads a scene);
## the spec can then go to Creature.build on a worker thread.
static func fit(s: Dictionary) -> void:
	var scene: Node3D = (load(SCENE) as PackedScene).instantiate()
	var sk := _skeleton(scene)
	var J := PackedVector3Array(); J.resize(C.NB + 5)
	var bones := PackedInt32Array(); bones.resize(C.NB)
	# The rig's rest pose may sit under scaled/rotated parents; measure in scene space.
	var to_scene := _to_root(sk, scene)
	for i in C.NB:
		bones[i] = sk.find_bone(MAP[i])
		J[i] = to_scene * sk.get_bone_global_rest(bones[i]).origin
	for side in 2:
		var o := C.RIGHT * side
		var sfx := ".R" if side else ".L"
		var tip: Vector3 = to_scene * sk.get_bone_global_rest(sk.find_bone("DEF-f_middle.03" + sfx)).origin
		J[C.NB + side] = J[C.HAND + o] + (tip - J[C.HAND + o]) * 1.25
		J[C.NB + 2 + side] = J[C.TOE + o] + Vector3(0, 0, 0.07)
	J[C.NB + 4] = J[C.HEAD] + Vector3(0, 0.2, 0)
	s.rig_joints = J
	s.rig_bones = bones
	s.rig_scale = to_scene.basis.get_scale().x
	s.height = J[C.HEAD].y + 0.19
	scene.free()

static func _to_root(n: Node3D, root: Node) -> Transform3D:
	var t := Transform3D.IDENTITY
	var cur: Node = n
	while cur != root and cur != null:
		if cur is Node3D:
			t = (cur as Node3D).transform * t
		cur = cur.get_parent()
	return t

## Scene instance with the generated body skinned to the library skeleton.
## Returns the root; meta "anim" is its AnimationPlayer.
static func instantiate(data: Dictionary) -> Node3D:
	var scene: Node3D = (load(SCENE) as PackedScene).instantiate()
	var sk := _skeleton(scene)
	for c in sk.get_children():
		if c is MeshInstance3D:
			c.queue_free()          # the mannequin is only a donor of bones and motion
	var to_scene := _to_root(sk, scene)
	var skin := Skin.new()
	for i in sk.get_bone_count():
		# Generated vertices are in scene space; binds take them into each bone's space.
		skin.add_bind(i, (to_scene * sk.get_bone_global_rest(i)).affine_inverse())
	var mi := MeshInstance3D.new()
	mi.mesh = C.make_mesh(data)
	mi.skin = skin
	sk.add_child(mi)
	mi.skeleton = NodePath("..")
	# Cancel the skeleton's own parent transform: the mesh is authored in scene space.
	mi.transform = to_scene.affine_inverse()
	mi.custom_aabb = AABB(Vector3(-3, -1, -3), Vector3(6, 6, 6))
	var ap := _player(scene)
	scene.set_meta("anim", ap)
	return scene
